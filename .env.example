# Copy this file to .env and fill in real values.
# .env is read by run_daily.sh (the launchd job) and can also be sourced manually.

# From @BotFather on Telegram (send /newbot).
TELEGRAM_BOT_TOKEN="123456789:AAExampleTokenReplaceMe"

# Send any message to your bot, then open:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# and read the numeric chat id from result[0].message.chat.id
TELEGRAM_CHAT_ID="123456789"

# Strongly recommended (it used to be optional). SEC's fair-access policy asks for
# a descriptive contact string on every request, and it now enforces that: the
# generic placeholder this code falls back to gets throttled with HTTP 503 on the
# daily index, which costs you that day's filings until the next run picks it up.
# Put a real address here.
SEC_USER_AGENT="MyDisclosureBot your-real-email@example.com"

# Optional. Ethereum JSON-RPC endpoint for --onchain wallet balances; defaults to
# a public node (ethereum-rpc.publicnode.com). No key needed either way.
# ETH_RPC_URL="https://ethereum-rpc.publicnode.com"
